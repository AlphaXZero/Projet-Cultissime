@startuml
skinparam backgroundColor transparent
skinparam shadowing false
skinparam objectBorderColor #6e1423
skinparam objectBackgroundColor #faf5f5
skinparam ArrowColor #6e1423
left to right direction
title Jouer une partie — collaboration de conception (E3 : temps écoulé)


object "Joueur" as A
object ":IHMJeu" as IHM
object ":CtrlPartie" as C
object "partie:Partie" as P

C -[#6e1423]-> IHM : 1: «minuté» afficherQuestion(q, temps)
IHM -[#6e1423]-> A : 2: afficherQuestion(q)
C -[#6e1423]-> C : 3: échéanceChronomètre()
A -[#6e1423]-> IHM : 4: soumettreRéponse(rép)
IHM -[#6e1423]-> C : 5: «dérobant» enregistrerRéponse(idJoueur, rép)
C -[#6e1423]-> P : 6: clôturerQuestion(sansRéponse, idJoueur)
C -[#6e1423]-> IHM : 7: afficherRésultat(nonRépondu, 0 point)
C -[#6e1423]-> IHM : 8: afficherClassement()
@enduml