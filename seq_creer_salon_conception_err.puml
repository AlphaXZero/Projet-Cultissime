@startuml
title Créer un salon — séquence de conception (E2 : configuration incohérente)
skinparam backgroundColor transparent
skinparam shadowing false
skinparam sequenceArrowColor #6e1423
skinparam sequenceLifeLineBorderColor #6e1423
skinparam sequenceParticipantBorderColor #6e1423
skinparam sequenceParticipantBackgroundColor #faf5f5
skinparam actorBorderColor #333333

actor "Joueur" as J
boundary ":IHMSalon" as IHM
control ":CtrlSalon" as C

J -> IHM : configurerPartie(paramètres)
activate IHM
IHM -> C : créerSalon(configuration, idHôte)
activate C
C -> C : vérifierCohérence(configuration)
note right of C : paramètres en conflit :\nl'objet Salon n'est pas créé,\nrien n'est enregistré
C --> IHM : paramètresEnConflit(détails)
deactivate C
IHM --> J : signalerConflit(détails)
deactivate IHM

@enduml
