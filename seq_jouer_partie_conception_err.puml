@startuml
title Jouer une partie — séquence de conception (E3 : temps écoulé sans réponse)
skinparam backgroundColor transparent
skinparam shadowing false
skinparam sequenceArrowColor #6e1423
skinparam sequenceLifeLineBorderColor #6e1423
skinparam sequenceParticipantBorderColor #6e1423
skinparam sequenceParticipantBackgroundColor #faf5f5
skinparam actorBorderColor #333333

actor "Joueur" as J
boundary ":IHMJeu" as IHM
control ":CtrlPartie" as C
entity "partie:Partie" as P

C ->> IHM : <<minuté>> afficherQuestion(question, tempsImparti)
activate C
IHM ->> J : afficherQuestion(question)
C -> C : échéanceChronomètre()
J -> IHM : soumettreRéponse(réponse)
activate IHM
IHM ->x C : <<dérobant>> enregistrerRéponse(idJoueur, réponse)
note right of IHM : la question est close :\nle message est abandonné
deactivate IHM
C -> P : clôturerQuestion(sansRéponse, idJoueur)
activate P
P --> C : zéroPoint
deactivate P
C ->> IHM : afficherRésultat(nonRépondu, 0 point)
C ->> IHM : afficherClassement(classement)
deactivate C

@enduml
