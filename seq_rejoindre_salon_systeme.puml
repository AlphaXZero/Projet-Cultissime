@startuml
title Rejoindre un salon — séquence système (nominal)
skinparam backgroundColor transparent
skinparam shadowing false
skinparam sequenceArrowColor #6e1423
skinparam sequenceLifeLineBorderColor #6e1423
skinparam sequenceParticipantBorderColor #6e1423
skinparam sequenceParticipantBackgroundColor #faf5f5
skinparam actorBorderColor #333333

actor "Joueur" as J
participant "Système" as S

J -> S : consulterSalonsPublics()
activate S
S --> J : listeSalons(salons)
deactivate S

J -> S : rejoindreSalon(idSalon)
activate S
S -> S : vérifierDisponibilité(idSalon)
S --> J : salonRejoint(étatSalon)
deactivate S
@enduml