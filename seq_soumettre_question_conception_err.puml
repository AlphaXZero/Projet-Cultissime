@startuml
title Soumettre une question — séquence de conception (E1 : champ obligatoire manquant)
skinparam backgroundColor transparent
skinparam shadowing false
skinparam sequenceArrowColor #6e1423
skinparam sequenceLifeLineBorderColor #6e1423
skinparam sequenceParticipantBorderColor #6e1423
skinparam sequenceParticipantBackgroundColor #faf5f5
skinparam actorBorderColor #333333

actor "Utilisateur\nauthentifié" as U
boundary ":IHMQuestion" as IHM
control ":CtrlContenu" as C

U -> IHM : soumettreQuestion(donnéesIncomplètes)
activate IHM
IHM -> C : soumettreQuestion(données)
activate C
C -> C : validerChamps(données)
note right of C : champ manquant : aucun objet\nQuestion créé, aucun accès\nà la base de données
C --> IHM : champsManquants(liste)
deactivate C
IHM --> U : indiquerChampsÀCompléter(liste)
deactivate IHM

@enduml
