@startuml
title Souscrire un abonnement — séquence système (nominal)
skinparam backgroundColor transparent
skinparam shadowing false
skinparam sequenceArrowColor #6e1423
skinparam sequenceLifeLineBorderColor #6e1423
skinparam sequenceParticipantBorderColor #6e1423
skinparam sequenceParticipantBackgroundColor #faf5f5
skinparam actorBorderColor #333333

actor "Utilisateur\nauthentifié" as U
participant "Système" as S
participant "Prestataire\nde paiement" as P

U -> S : sélectionnerAbonnement()
activate S
S --> U : afficherRécapitulatif(offre, prix)
deactivate S

U -> S : confirmerPaiement(infosPaiement)
activate S
S -> P : demanderPaiement(montant, infosPaiement)
activate P
P --> S : paiementConfirmé()
deactivate P
S -> S : activerAbonnement()
S --> U : abonnementActivé()
deactivate S
@enduml